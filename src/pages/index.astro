  <script>
    const updateShopStatus = () => {
      const parts = new Intl.DateTimeFormat('en-US', {
        timeZone: 'America/Chicago',
        weekday: 'short',
        hour: '2-digit',
        minute: '2-digit',
        hourCycle: 'h23',
      }).formatToParts(new Date());

      const values = Object.fromEntries(parts.map(({ type, value }) => [type, value]));
      const weekday = values.weekday;
      const minutes = Number(values.hour) * 60 + Number(values.minute);
      const weekdays = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'];
      const isWeekday = weekdays.includes(weekday);
      const isOpen = isWeekday && minutes >= 450 && minutes < 1050;

      let text = 'Closed now · opens Monday at 7:30 AM';
      if (isOpen) text = 'Open now · closes at 5:30 PM';
      else if (isWeekday && minutes < 450) text = 'Closed now · opens at 7:30 AM';
      else if (weekday !== 'Fri' && weekday !== 'Sat' && weekday !== 'Sun') text = 'Closed now · opens tomorrow at 7:30 AM';

      document.querySelectorAll<HTMLElement>('[data-status-text]').forEach((element) => {
        element.textContent = text;
      });
      document.querySelectorAll<HTMLElement>('[data-status-dot]').forEach((element) => {
        element.classList.toggle('bg-safety', isOpen);
        element.classList.toggle('bg-rust', !isOpen);
      });
    };

    updateShopStatus();
    window.setInterval(updateShopStatus, 60_000);

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const revealElements = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));
      const importGsap = () => import('gsap').then(({ default: gsap }) => gsap);
      let gsapPromise: ReturnType<typeof importGsap> | undefined;
      const getGsap = () => {
        gsapPromise ??= importGsap();
        return gsapPromise;
      };

      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(async (entry) => {
          if (!entry.isIntersecting) return;
          const element = entry.target as HTMLElement;
          revealObserver.unobserve(element);
          const gsap = await getGsap();
          gsap.fromTo(element, { y: 32 }, { y: 0, duration: 0.7, ease: 'power2.out', clearProps: 'transform' });
        });
      }, { rootMargin: '0px 0px -6% 0px', threshold: 0.08 });

      revealElements.forEach((element) => revealObserver.observe(element));
    }

    const form = document.querySelector<HTMLFormElement>('#contact-form');
    const submitButton = document.querySelector<HTMLButtonElement>('#submit-button');
    const formStatus = document.querySelector<HTMLElement>('#form-status');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity() || !submitButton || !formStatus) return;

      submitButton.disabled = true;
      submitButton.textContent = 'Sending…';
      formStatus.classList.add('hidden');

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.message || 'We could not send your message.');

        form.reset();
        formStatus.textContent = result.message;
        formStatus.className = 'mt-5 border border-safety/60 bg-safety/10 px-4 py-3 text-sm text-safety';
      } catch (error) {
        formStatus.textContent = error instanceof Error ? error.message : 'Something went wrong. Please call the shop instead.';
        formStatus.className = 'mt-5 border border-rust/70 bg-rust/10 px-4 py-3 text-sm text-[#ff9c86]';
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = 'Send to the shop';
      }
    });
  </script>
